{
  "name": "da2",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:reset": "docker compose --env-file .env -f infra/docker-compose.yml down -v",
    "db:bootstrap": "npm run bootstrap -w scripts",
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run dev -w apps/worker",
    "evidence": "npm run evidence -w scripts --",
    "typecheck": "tsc -p packages/shared && tsc -p apps/api && tsc -p apps/worker && tsc -p scripts && tsc -p tests && tsc -p apps/web",
    "db:seed": "npm run seed -w scripts",
    "dev:web": "npm run dev -w apps/web",
    "db:shell": "npm run shell -w scripts --",
    "redis:cli": "docker exec -it redis redis-cli",
    "db:seed-users": "npm run seed-users -w scripts",
    "sim:backfill": "npm run sim:backfill -w scripts --",
    "sim:live": "npm run sim:live -w scripts --",
    "test": "node --import tsx --test --test-reporter=spec tests/unit/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
