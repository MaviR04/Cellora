# --- MongoDB (replica set rs0, authentication on) ---
# Shared secret the replica set members use to authenticate to each other (base64, 6-1024 chars)
MONGO_KEYFILE=ZGV2LW9ubHkta2V5ZmlsZS1jaGFuZ2UtbWUtZm9yLXJlYWwtZGVwbG95bWVudHM=
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=dev-root-pw
MONGO_APP_USER=da2_app
MONGO_APP_PASSWORD=dev-app-pw
MONGO_ANALYST_USER=da2_analyst
MONGO_ANALYST_PASSWORD=dev-analyst-pw

# host.docker.internal is added to the Windows hosts file by Docker Desktop.
# App user: readWrite + dbAdmin on da2, clusterMonitor (health page).
MONGO_URI=mongodb://da2_app:dev-app-pw@host.docker.internal:27017,host.docker.internal:27018,host.docker.internal:27019/da2?replicaSet=rs0&authSource=admin
# Analyst user: read-only, reads from secondaries (UC1-UC3).
MONGO_ANALYST_URI=mongodb://da2_analyst:dev-analyst-pw@host.docker.internal:27017,host.docker.internal:27018,host.docker.internal:27019/da2?replicaSet=rs0&authSource=admin&readPreference=secondaryPreferred

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
SESSION_SECRET=change-me
